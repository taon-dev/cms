#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:103
msgid "Authentication is required to comment."
msgstr "Aby komentować, musisz się zalogować."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:124
msgid "You can't manage CMS comments."
msgstr "Nie masz uprawnień do zarządzania komentarzami CMS."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:169
msgid "A post and comment text are required."
msgstr "Wpis i treść komentarza są wymagane."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:175
msgid "Comments cannot exceed 500 characters."
msgstr "Komentarz nie może przekraczać 500 znaków."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:185
#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:308
#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:354
msgid "The post was not found."
msgstr "Nie znaleziono wpisu."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:196
msgid "Your account is not allowed to comment."
msgstr "Twoje konto nie ma uprawnień do komentowania."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:211
msgid "Your comment contains a blocked word or phrase."
msgstr "Komentarz zawiera zablokowane słowo lub frazę."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:228
msgid "You have reached the limit of 50 comments per day."
msgstr "Osiągnięto dzienny limit 50 komentarzy."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:257
#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:299
#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:345
msgid "The comment was not found."
msgstr "Nie znaleziono komentarza."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:267
msgid "You are not allowed to delete this comment."
msgstr "Nie masz uprawnień do usunięcia tego komentarza."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:291
msgid "Choose a valid comment vote."
msgstr "Wybierz prawidłowy głos dla komentarza."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:338
msgid "A valid comment is required."
msgstr "Wymagany jest prawidłowy komentarz."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:443
msgid "A valid user ID and blocked status are required."
msgstr "Wymagany jest prawidłowy identyfikator użytkownika i status blokady."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:455
msgid "The user was not found."
msgstr "Nie znaleziono użytkownika."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:496
msgid "Enter a word or phrase of at most 500 characters."
msgstr "Wprowadź słowo lub frazę o długości do 500 znaków."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:524
msgid "The blocked phrase was not found."
msgstr "Nie znaleziono zablokowanej frazy."

#: src/lib/taon-cms-comment/taon-cms-comment.controller.ts:560
msgid "You do not have access to this post."
msgstr "Nie masz dostępu do tego wpisu."

msgid "The post version could not be removed. Reload the post and try again."
msgstr "Die Beitragsversion konnte nicht entfernt werden. Laden Sie den Beitrag neu und versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1463
msgid "Application hooks could not be loaded. Please try again."
msgstr "Die Anwendungs-Hooks konnten nicht geladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1520
msgid "Permissions could not be loaded. Please try again."
msgstr "Die Berechtigungen konnten nicht geladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1593
msgid "Available permissions could not be loaded. Please try again."
msgstr "Die verfügbaren Berechtigungen konnten nicht geladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1675
msgid "Unable to read the selected media file."
msgstr "Die ausgewählte Mediendatei kann nicht gelesen werden."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1727
msgid "The video was uploaded, but its thumbnail could not be generated. Upload a thumbnail or apply a default placeholder."
msgstr "Das Video wurde hochgeladen, aber das Vorschaubild konnte nicht erstellt werden. Laden Sie ein Vorschaubild hoch oder verwenden Sie einen Standardplatzhalter."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1737
msgid "The media could not be uploaded. Please try again."
msgstr "Die Medien konnten nicht hochgeladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1866
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1928
msgid "A title and slug are required."
msgstr "Ein Titel und ein Slug sind erforderlich."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1905
msgid "Change post status"
msgstr "Beitragsstatus ändern"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1907
msgid "Published"
msgstr "Veröffentlicht"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1908
msgid "Draft"
msgstr "Entwurf"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1909
msgid "Archived"
msgstr "Archiviert"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1970
msgid "this post"
msgstr "dieser Beitrag"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2053
msgid "Permanently delete post?"
msgstr "Beitrag dauerhaft löschen?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2054
msgid "Archive post?"
msgstr "Beitrag archivieren?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2056
msgid "This permanently deletes the post and its assets. This action cannot be undone."
msgstr "Dadurch werden der Beitrag und seine Dateien dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2059
msgid "This archives the post. It can be restored from its revisions."
msgstr "Der Beitrag wird archiviert. Er kann aus einer seiner Revisionen wiederhergestellt werden."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2063
msgid "Permanently delete"
msgstr "Dauerhaft löschen"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2064
msgid "Delete"
msgstr "Löschen"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2093
msgid "The post could not be permanently deleted. Please refresh before retrying."
msgstr "Der Beitrag konnte nicht dauerhaft gelöscht werden. Bitte aktualisieren Sie die Seite, bevor Sie es erneut versuchen."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2131
msgid "Duplicate post"
msgstr "Beitrag duplizieren"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2135
msgid "Duplicate only this post"
msgstr "Nur diesen Beitrag duplizieren"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2139
msgid "Duplicate this post and its children"
msgstr "Diesen Beitrag und seine untergeordneten Beiträge duplizieren"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2165
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2189
msgid "The post could not be duplicated. Please try again."
msgstr "Der Beitrag konnte nicht dupliziert werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2223
msgid "No post is loaded."
msgstr "Es ist kein Beitrag geladen."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2352
msgid "The post could not be saved. Check the slug and your connection. If another user changed it, close and reopen the post before retrying."
msgstr "Der Beitrag konnte nicht gespeichert werden. Überprüfen Sie den Slug und Ihre Verbindung. Falls ein anderer Benutzer den Beitrag geändert hat, schließen Sie ihn und öffnen Sie ihn erneut, bevor Sie es noch einmal versuchen."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2637
msgid "A title and slug are required."
msgstr "Ein Titel und ein Slug sind erforderlich."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2614
msgid "Change post status"
msgstr "Beitragsstatus ändern"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2616
msgid "Published"
msgstr "Veröffentlicht"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2617
msgid "Draft"
msgstr "Entwurf"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2618
msgid "Archived"
msgstr "Archiviert"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2679
msgid "this post"
msgstr "dieser Beitrag"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2762
msgid "Permanently delete post?"
msgstr "Beitrag dauerhaft löschen?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2763
msgid "Archive post?"
msgstr "Beitrag archivieren?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2765
msgid "This permanently deletes the post and its assets. This action cannot be undone."
msgstr "Dadurch werden der Beitrag und seine Dateien dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2768

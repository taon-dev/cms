#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:680
msgid "The thumbnail could not be loaded."
msgstr "Das Vorschaubild konnte nicht geladen werden."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:769
msgid "Media preview could not be loaded. Please reopen the editor to try again."
msgstr "Die Medienvorschau konnte nicht geladen werden. Bitte öffnen Sie den Editor erneut und versuchen Sie es noch einmal."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:838
msgid "Categories and tags could not be loaded. Please try again."
msgstr "Kategorien und Tags konnten nicht geladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:930
msgid "The category could not be created. Please try again."
msgstr "Die Kategorie konnte nicht erstellt werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:933
msgid "The tag could not be created. Please try again."
msgstr "Das Schlagwort konnte nicht erstellt werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:967
msgid "Please select an image for the thumbnail."
msgstr "Bitte wählen Sie ein Bild als Vorschaubild aus."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:978
msgid "The thumbnail could not be uploaded. Please try again."
msgstr "Das Vorschaubild konnte nicht hochgeladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1051

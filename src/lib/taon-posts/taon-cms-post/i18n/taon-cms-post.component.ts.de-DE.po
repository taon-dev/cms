#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2403
msgid "The media upload was cancelled."
msgstr "Der Medien-Upload wurde abgebrochen."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2408
msgid "The media could not be uploaded. Please try again."
msgstr "Die Medien konnten nicht hochgeladen werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2437
msgid "The file \"[[ fileName ]]\" is too large. The maximum upload size is 1 GB."
msgstr ""


#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:155
msgid "Audio Attachment"
msgstr "Audioanhang"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:156
msgid "Upload audio"
msgstr "Audio hochladen"


msgstr "Nie udało się załadować dostępnych uprawnień. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1530
msgid "Unable to read the selected media file."
msgstr "Nie można odczytać wybranego pliku multimedialnego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1582
msgid "The video was uploaded, but its thumbnail could not be generated. Upload a thumbnail or apply a default placeholder."
msgstr "Wideo zostało przesłane, ale nie udało się wygenerować miniatury. Prześlij miniaturę lub użyj domyślnego obrazu zastępczego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1592
msgid "The media could not be uploaded. Please try again."
msgstr "Nie udało się przesłać multimediów. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1721
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1757
msgid "A title and slug are required."
msgstr "Wymagany jest tytuł i slug."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1845
msgid "Delete post?"
msgstr "Usunąć wpis?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1846
msgid "This archives the post. It can be restored from its revisions."
msgstr "Ta operacja archiwizuje wpis. Można go przywrócić z jednej z jego wersji."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1849
msgid "Delete"
msgstr "Usunięcie"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1886
msgid "The post could not be duplicated. Please try again."
msgstr "Nie udało się zduplikować wpisu. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1918
msgid "No post is loaded."
msgstr "Żaden wpis nie jest załadowany."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2036
msgid "The post could not be saved. Check the slug and your connection. If another user changed it, close and reopen the post before retrying."
msgstr "Nie udało się zapisać wpisu. Sprawdź slug i połączenie. Jeśli inny użytkownik go zmienił, zamknij wpis i otwórz go ponownie przed ponowną próbą."

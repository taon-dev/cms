msgid "Post version"
msgstr "Wersja wpisu"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1479
msgid "Select an eligible post version."
msgstr "Wybierz wpis odpowiedni dla tej wersji."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1518
msgid "The post version could not be linked. Reload the post and try again."
msgstr "Nie udało się połączyć wersji wpisu. Wczytaj ponownie wpis i spróbuj jeszcze raz."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1560
msgid "The post version could not be removed. Reload the post and try again."
msgstr "Nie udało się usunąć powiązania wersji wpisu. Wczytaj ponownie wpis i spróbuj jeszcze raz."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1593
msgid "Application hooks could not be loaded. Please try again."
msgstr "Nie udało się załadować hooków aplikacji. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1650
msgid "Permissions could not be loaded. Please try again."
msgstr "Nie udało się załadować uprawnień. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1723
msgid "Available permissions could not be loaded. Please try again."
msgstr "Nie udało się załadować dostępnych uprawnień. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1842
msgid "Unable to read the selected files."
msgstr "Nie udało się odczytać wybranych plików."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2043
msgid "The creation result could not be verified; retrying will not duplicate an existing child."
msgstr "Nie udało się zweryfikować wyniku tworzenia. Ponowna próba nie zduplikuje istniejącego wpisu potomnego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2181
msgid "An uploaded file is still linked to a post and was not deleted."
msgstr "Przesłany plik jest nadal powiązany z wpisem i nie został usunięty."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2194
msgid "An uploaded file could not be cleaned up."
msgstr "Nie udało się usunąć przesłanego pliku."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2227
msgid "Unable to read the selected media file."
msgstr "Nie można odczytać wybranego pliku multimedialnego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2279
msgid "The video was uploaded, but its thumbnail could not be generated. Upload a thumbnail or apply a default placeholder."
msgstr "Wideo zostało przesłane, ale nie udało się wygenerować miniatury. Prześlij miniaturę lub użyj domyślnego obrazu zastępczego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2289
msgid "The media could not be uploaded. Please try again."
msgstr "Nie udało się przesłać multimediów. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2418
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2480
msgid "A title and slug are required."
msgstr "Wymagane są tytuł i slug."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2457
msgid "Change post status"
msgstr "Zmień status wpisu"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2459
msgid "Published"
msgstr "Opublikowany"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2460
msgid "Draft"
msgstr "Szkic"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2461
msgid "Archived"
msgstr "Zarchiwizowany"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2522
msgid "this post"
msgstr "ten wpis"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2605
msgid "Permanently delete post?"
msgstr "Trwale usunąć wpis?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2606
msgid "Archive post?"
msgstr "Zarchiwizować wpis?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2608
msgid "This permanently deletes the post and its assets. This action cannot be undone."
msgstr "Ta operacja trwale usuwa wpis i jego zasoby. Nie można jej cofnąć."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2611
msgid "This archives the post. It can be restored from its revisions."
msgstr "Ta operacja archiwizuje wpis. Można go przywrócić z jednej z jego wersji."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2615
msgid "Permanently delete"
msgstr "Usuń trwale"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2616
msgid "Delete"
msgstr "Usuń"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2645
msgid "The post could not be permanently deleted. Please refresh before retrying."
msgstr "Nie udało się trwale usunąć wpisu. Odśwież stronę przed ponowną próbą."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2683
msgid "Duplicate post"
msgstr "Duplikuj wpis"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2687
msgid "Duplicate only this post"
msgstr "Duplikuj tylko ten wpis"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2691
msgid "Duplicate this post and its children"
msgstr "Duplikuj ten wpis i jego wpisy podrzędne"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2717
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2741
msgid "The post could not be duplicated. Please try again."
msgstr "Nie udało się zduplikować wpisu. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2775
msgid "No post is loaded."
msgstr "Żaden wpis nie jest załadowany."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2913
msgid "The post could not be saved. Check the slug and your connection. If another user changed it, close and reopen the post before retrying."
msgstr "Nie udało się zapisać wpisu. Sprawdź slug i połączenie. Jeśli inny użytkownik go zmienił, zamknij wpis i otwórz go ponownie przed ponowną próbą."

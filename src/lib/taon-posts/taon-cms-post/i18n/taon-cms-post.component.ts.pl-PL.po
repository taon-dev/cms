msgid "Change post status"
msgstr "Zmień status wpisu"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1962
msgid "Published"
msgstr "Opublikowany"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1963
msgid "Draft"
msgstr "Szkic"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1964

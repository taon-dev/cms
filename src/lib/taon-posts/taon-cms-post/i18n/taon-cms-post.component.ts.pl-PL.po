#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2874
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2898
msgid "The post could not be duplicated. Please try again."
msgstr "Nie udało się zduplikować wpisu. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:2932
msgid "No post is loaded."
msgstr "Żaden wpis nie jest załadowany."


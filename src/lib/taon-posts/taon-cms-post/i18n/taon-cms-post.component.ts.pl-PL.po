#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:378
msgid "The thumbnail could not be loaded."
msgstr "Nie udało się wczytać miniatury."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:447
msgid "Media preview could not be loaded. Please reopen the editor to try again."
msgstr "Nie udało się załadować podglądu multimediów. Otwórz ponownie edytor, aby spróbować jeszcze raz."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:500
msgid "Categories and tags could not be loaded. Please try again."
msgstr "Nie udało się wczytać kategorii i tagów. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:548
msgid "Please select an image for the thumbnail."
msgstr "Wybierz obraz miniatury."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:559
msgid "The thumbnail could not be uploaded. Please try again."
msgstr "Nie udało się przesłać miniatury. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:626
msgid "Related posts could not be loaded. Please try again."
msgstr "Nie udało się załadować powiązanych wpisów. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:715
msgid "Application hooks could not be loaded. Please try again."
msgstr "Nie udało się załadować hooków aplikacji. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:766
msgid "Permissions could not be loaded. Please try again."
msgstr "Nie udało się załadować uprawnień. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:839
msgid "Available permissions could not be loaded. Please try again."
msgstr "Nie udało się załadować dostępnych uprawnień. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:860
msgid "Unable to read the selected media file."
msgstr "Nie można odczytać wybranego pliku multimedialnego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:912
msgid "The video was uploaded, but its thumbnail could not be generated. Upload a thumbnail or apply a default placeholder."
msgstr "Wideo zostało przesłane, ale nie udało się wygenerować miniatury. Prześlij miniaturę lub użyj domyślnego obrazu zastępczego."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:922
msgid "The media could not be uploaded. Please try again."
msgstr "Nie udało się przesłać multimediów. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1051
#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1087
msgid "A title and slug are required."
msgstr "Wymagany jest tytuł i slug."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1175
msgid "Delete post?"
msgstr "Usunąć wpis?"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1176
msgid "This archives the post. It can be restored from its revisions."
msgstr "Ta operacja archiwizuje wpis. Można go przywrócić z jednej z jego wersji."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1179
msgid "Delete"
msgstr "Usunięcie"

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1216
msgid "The post could not be duplicated. Please try again."
msgstr "Nie udało się zduplikować wpisu. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1248
msgid "No post is loaded."
msgstr "Żaden wpis nie jest załadowany."

#: src/lib/taon-posts/taon-cms-post/taon-cms-post.component.ts:1360
msgid "The post could not be saved. Check the slug and your connection. If another user changed it, close and reopen the post before retrying."
msgstr "Nie udało się zapisać wpisu. Sprawdź slug i połączenie. Jeśli inny użytkownik go zmienił, zamknij wpis i otwórz go ponownie przed ponowną próbą."

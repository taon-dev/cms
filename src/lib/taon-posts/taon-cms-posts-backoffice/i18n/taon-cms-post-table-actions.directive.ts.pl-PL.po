#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:43
msgid "Actions"
msgstr "Akcje"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:50
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:132
msgid "Duplicate post"
msgstr "Duplikuj wpis"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:57
msgid "Post details"
msgstr "Szczegóły wpisu"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:63
msgid "Archive or permanently delete post"
msgstr "Archiwizuj lub trwale usuń wpis"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:86
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:104
msgid "The Post details route is unavailable."
msgstr "Trasa szczegółów wpisu jest niedostępna."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:136
msgid "Duplicate only this post"
msgstr "Duplikuj tylko ten wpis"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:142
msgid "Duplicate this post and its children"
msgstr "Duplikuj ten wpis i jego wpisy podrzędne"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:168
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:195
msgid "The post could not be duplicated. Please try again."
msgstr "Nie udało się zduplikować wpisu. Spróbuj ponownie."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:212
msgid "Permanently delete post?"
msgstr "Trwale usunąć wpis?"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:213
msgid "Archive post?"
msgstr "Zarchiwizować wpis?"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:215
msgid "This permanently deletes the post and its assets. This action cannot be undone."
msgstr "Ta operacja trwale usuwa wpis i jego zasoby. Nie można jej cofnąć."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:218
msgid "This archives the post. It can be restored from its revisions."
msgstr "Ta operacja archiwizuje wpis. Można go przywrócić z jednej z jego wersji."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:222
msgid "Permanently delete"
msgstr "Usuń trwale"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:223
msgid "Delete"
msgstr "Usuń"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:250
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:271
msgid "The post could not be deleted. Refresh the table before retrying."
msgstr "Nie udało się usunąć wpisu. Odśwież tabelę przed ponowną próbą."

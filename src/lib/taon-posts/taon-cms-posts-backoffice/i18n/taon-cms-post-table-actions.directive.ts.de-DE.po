#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:45
msgid "Actions"
msgstr "Aktionen"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:52
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:135
msgid "Duplicate post"
msgstr "Beitrag duplizieren"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:59
msgid "Post details"
msgstr "Beitragsdetails"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:65
msgid "Archive or permanently delete post"
msgstr "Beitrag archivieren oder dauerhaft löschen"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:88
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:107
msgid "The Post details route is unavailable."
msgstr "Die Route für die Beitragsdetails ist nicht verfügbar."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:139
msgid "Duplicate only this post"
msgstr "Nur diesen Beitrag duplizieren"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:145
msgid "Duplicate this post and its children"
msgstr "Diesen Beitrag und seine untergeordneten Beiträge duplizieren"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:171
#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:198
msgid "The post could not be duplicated. Please try again."
msgstr "Der Beitrag konnte nicht dupliziert werden. Bitte versuchen Sie es erneut."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:215
msgid "Permanently delete post?"
msgstr "Beitrag dauerhaft löschen?"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:216
msgid "Archive post?"
msgstr "Beitrag archivieren?"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:218
msgid "This permanently deletes the post and its assets. This action cannot be undone."
msgstr "Dadurch werden der Beitrag und seine Dateien dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:221
msgid "This archives the post. It can be restored from its revisions."
msgstr "Dadurch wird der Beitrag archiviert. Er kann aus einer seiner Revisionen wiederhergestellt werden."

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:225
msgid "Permanently delete"
msgstr "Dauerhaft löschen"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:226
msgid "Delete"
msgstr "Löschen"

#: src/lib/taon-posts/taon-cms-posts-backoffice/taon-cms-post-table-actions.directive.ts:255
msgid "The post could not be deleted. Refresh the table before retrying."
msgstr "Der Beitrag konnte nicht gelöscht werden. Bitte aktualisieren Sie die Tabelle, bevor Sie es erneut versuchen."
